#!/usr/bin/env bash
set -euo pipefail
fail() { printf '✗ %s\n' "$*" >&2; exit 1; }
if [[ ${LLM_STACK_CONTAINER:-} == 1 ]]; then
  exec python /app/bin/models.py "$@"
fi
cd "$(dirname "$0")/.."
case "${1:---help}" in
  --help|-h|help)
    cat <<'HELP'
Usage: bin/models COMMAND [OPTIONS]

  list                Show installed models and gateway registrations
  search [QUERY]      Browse selected developers in Ollama's public catalog
  tags MODEL          Show standard tags and download sizes
  tags MODEL --all    Show all local variants
  tags MODEL:TAG      Filter variants by tag prefix
  add MODEL:TAG       Download and register a chat model
  remove MODEL:TAG    Unregister and delete after confirmation
  doctor              Probe internal APIs without changing state

Use bin/models COMMAND --help for command-specific options.
Examples: bin/models search qwen; bin/models tags qwen3
HELP
    exit 0 ;;
esac
command -v docker >/dev/null || fail 'Docker is not installed.'
docker info >/dev/null 2>&1 || fail 'Docker is unavailable. Start Docker and check permissions.'
docker compose version >/dev/null 2>&1 || fail 'Docker Compose v2 is required.'
running=$(docker compose ps --status running --services) || fail 'Cannot inspect Compose project. Check .env and configuration.'
services=(postgres ollama litellm)
case "$1" in search|tags|doctor) services=(litellm) ;; esac
if [[ ${2:-} == --help || ${2:-} == -h ]]; then services=(litellm); fi
for service in "${services[@]}"; do
  grep -qx "$service" <<<"$running" || fail "$service is not running. Run docker compose up -d."
done
if [[ -t 0 && -t 1 ]]; then
  exec docker compose exec litellm /app/bin/models "$@"
else
  exec docker compose exec -T litellm /app/bin/models "$@"
fi
